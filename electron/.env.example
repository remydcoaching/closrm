# ClosRM Desktop (Electron) — local dev environment.
# Never commit the real .env — copy this file to .env.local.
# No server-side secret belongs here (no HIKER_API_KEY, APIFY, META_APP_SECRET,
# SUPABASE_SERVICE_ROLE_KEY, Stripe, AWS) — Electron only ever talks to the
# ClosRM API and to Supabase Auth with its public anon key.

VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=xxx
VITE_CLOSRM_API_BASE_URL=http://localhost:3000
VITE_CLOSRM_WEB_URL=http://localhost:3000
