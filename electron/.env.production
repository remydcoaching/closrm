# ClosRM Desktop — packaged app (vite build, mode "production").
# Overrides .env.local for the build only: the packaged app talks to the
# production API instead of a local dev server. Public URLs only — Supabase
# URL / anon key still come from .env.local. `npm run dev` keeps localhost.
VITE_CLOSRM_API_BASE_URL=https://closrm.fr
VITE_CLOSRM_WEB_URL=https://closrm.fr
